<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Languages of the interface, so macOS also localizes the menu items it adds. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>it</string>
  </array>
  <!-- Shown in the permission prompts. Translations: macos/<lang>.lproj/InfoPlist.strings -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Trama records your voice during meetings.</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>Trama records the other participants of your meetings.</string>
</dict>
</plist>
