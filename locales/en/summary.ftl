# Meeting summaries: errors of the summary job, by the codes the core returns.
# Each message id is `summary-error-` followed by the code, with `_` written as `-`.
# Errors of the provider call use the provider messages (providers.ftl).

summary-error-unsupported-source = Summaries are only written for meetings.
summary-error-no-transcript = The meeting has no transcript yet, so there is nothing to summarize.
summary-error-empty-transcript = No speech was recognized in the meeting, so there is nothing to summarize.
